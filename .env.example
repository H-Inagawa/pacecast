# リポジトリ直下に `.env` としてコピーし、値を入れる。
# `.env` は Git に載せない。Next.js の API もこのファイルを読む（`web/` から起動したとき）。

# Supabase（#46）。Project Settings → API の Project URL と service_role。
# service_role は秘密。anon キーでは動かない。画面の JavaScript には出さない。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# セッション署名。本番（Vercel）ではローカル既定値は使えない。長いランダム文字列にする。
PACECAST_SECRET=pacecast-local-secret

# 確認メール（Gmail）。送信用は PaceCast 専用アカウント。私用は使わない。
# 作り方は docs/06_dev/gmail-smtp.md
# https://myaccount.google.com/apppasswords
PACECAST_SMTP_HOST=smtp.gmail.com
PACECAST_SMTP_PORT=587
PACECAST_SMTP_USER=
PACECAST_SMTP_PASSWORD=
PACECAST_SMTP_FROM=

# 確認リンクの画面（Next.js）
PACECAST_APP_ORIGIN=http://127.0.0.1:3000
