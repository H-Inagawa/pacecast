# リポジトリ直下に `.env` としてコピーし、値を入れる。
# `.env` は Git に載せない。

# 確認メール（Gmail）
# 2段階認証を有効にしたうえで、アプリパスワードを発行する。
# https://myaccount.google.com/apppasswords
PACECAST_SMTP_HOST=smtp.gmail.com
PACECAST_SMTP_PORT=587
PACECAST_SMTP_USER=
PACECAST_SMTP_PASSWORD=
PACECAST_SMTP_FROM=

# 確認リンクの画面（Next.js）
PACECAST_APP_ORIGIN=http://127.0.0.1:3000
